{
  "name": "model-profiles-workspace",
  "private": true,
  "description": "Workspace for the OpenCode and Kilo CLI model profiles plugins and their shared core",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/opencode",
    "packages/kilo"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"packages/*/tests/*.test.ts\" \"packages/*/tests/*.test.mjs\" \"tests/*.test.mjs\"",
    "test:opencode": "node --experimental-strip-types --test \"packages/opencode/tests/*.test.ts\" \"packages/opencode/tests/*.test.mjs\"",
    "test:kilo": "node --experimental-strip-types --test \"packages/kilo/tests/*.test.ts\" \"packages/kilo/tests/*.test.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"packages/*/{src,tests}/**\" \"packages/*/{package.json,tsconfig*.json,schema.json}\" tests scripts package.json \"tsconfig*.json\" \"*.config.mjs\"",
    "format:check": "prettier --check \"packages/*/{src,tests}/**\" \"packages/*/{package.json,tsconfig*.json,schema.json}\" tests scripts package.json \"tsconfig*.json\" \"*.config.mjs\"",
    "check": "npm run check:static && npm test",
    "check:static": "concurrently --names typecheck,lint,format --kill-others-on-fail \"npm run typecheck\" \"npm run lint\" \"npm run format:check\"",
    "test:package": "npm run build && node --experimental-strip-types --test tests/package.integration.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.3.3",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
