{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    // The build reads the core's published declarations, as a user's install does.
    "paths": {}
  },
  "include": ["src/**/*.ts"]
}
