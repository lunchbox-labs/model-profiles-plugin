{
  "$schema": "https://cdn.jsdelivr.net/npm/@lunchbox-labs/opencode-model-profiles/schema.json",
  // Used when no profile is picked, and for any ref a profile leaves out.
  "defaults": {
    "reasoning": { "model": "openai/gpt-6-astra", "variant": "high" },
    // Any model setting an OpenCode agent takes can go with the model.
    "coding": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "textVerbosity": "low",
    },
    "support": { "model": "openai/gpt-5.6-terra", "variant": "medium" },
    "system": { "model": "openai/gpt-5.6-terra", "variant": "medium" },
  },
  "profiles": {
    "openai-latest": {
      "coding": { "model": "openai/gpt-6.1-sol", "variant": "medium" },
      "support": { "model": "openai/gpt-6-luna", "variant": "medium" },
    },
    "anthropic-latest": {
      "reasoning": { "model": "anthropic/claude-opus-5-5", "variant": "high" },
      "coding": { "model": "anthropic/claude-sonnet-5-5", "variant": "medium" },
      "support": { "model": "anthropic/claude-haiku-5-5", "variant": "medium" },
    },
  },
  // Built-in agents have no frontmatter of their own; give them refs here,
  // or set modelRef on their entry in opencode.jsonc.
  // Built-ins left out keep OpenCode's default model choice.
  "builtins": {
    "general": "coding",
    "explore": "support",
    "summary": "system",
    "compaction": "system",
    "title": "system",
  },
}
